    "Dark mice drain HP — game over at 0!" : {
      "comment" : "An instruction line in the maze game's How to Play section.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkle Mäuse verringern HP — bei 0 ist das Spiel vorbei!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark mice drain HP — game over at 0!"
          }
        },
