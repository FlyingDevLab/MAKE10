    "reset_confirm_high_score_body" : {
      "comment" : "Body text of the Reset High Score confirmation alert. Clarifies that all game records are erased but stickers are kept.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Spielrekorde werden gelöscht. Deine Sticker und deine Energie bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All game records will be erased. Your stickers and energy will stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán los récords de todos los juegos. Tus pegatinas y tu energía se conservarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les records seront effacés. Tes autocollants et ton énergie seront conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी गेम के रिकॉर्ड मिट जाएंगे। आपके स्टिकर और ऊर्जा बने रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua rekor permainan akan dihapus. Stiker dan energimu tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i record dei giochi verranno cancellati. I tuoi adesivi e la tua energia resteranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぜんぶのゲームの きろくが きえます。シールと エネルギーは のこります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 게임의 기록이 사라집니다. 스티커와 에너지는 그대로 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle spelrecords worden gewist. Je stickers en energie blijven bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os recordes de todos os jogos serão apagados. Seus adesivos e sua energia serão mantidos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สถิติของทุกเกมจะถูกลบ สติกเกอร์และพลังงานของคุณจะยังอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kỷ lục của tất cả trò chơi sẽ bị xóa. Nhãn dán và năng lượng của bạn vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有游戏的记录都会被清除。贴纸和能量会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有遊戲的紀錄都會被清除。貼紙和能量會保留。"
          }
        }
      }
    },
