    "update_gift_janken_note" : {
      "comment" : "Notice shown once after updating: Command Janken best times were reset because only no-mistake times are recorded now.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Befehl Stein-Schere-Papier“ zählt jetzt nur fehlerfreie Zeiten,\ndaher wurden die Bestzeiten zurückgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command Janken now records only times with no mistakes,\nso its best times have been reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Janken de Comandos» ahora solo registra tiempos sin errores,\nasí que se reiniciaron los récords."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Janken de Commande » n'enregistre plus que les temps sans erreur,\nles records ont donc été réinitialisés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमांड जनकेन अब सिर्फ़ बिना गलती वाला समय दर्ज करता है,\nइसलिए रिकॉर्ड रीसेट कर दिए गए हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janken Perintah kini hanya mencatat waktu tanpa salah,\njadi rekornya sudah direset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Janken dei Comandi» ora registra solo i tempi senza errori,\nquindi i record sono stati azzerati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指令じゃんけんは いちども まちがえなかった タイムだけを\nきろくするように なったので、きろくを リセットしたよ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령 가위바위보는 이제 실수 없는 기록만 남기므로\n기록을 초기화했어요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Opdracht Janken” bewaart nu alleen tijden zonder fouten,\ndus de records zijn gewist."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Janken de Comandos” agora só registra tempos sem erros,\npor isso os recordes foram zerados."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจงเก็นคำสั่งจะบันทึกเฉพาะเวลาที่ไม่พลาดเลย\nจึงรีเซ็ตสถิติแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oẳn tù tì theo Lệnh giờ chỉ ghi thời gian không sai lần nào,\nnên kỷ lục đã được đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指令剪刀石头布现在只记录零失误的时间，\n所以已重置记录"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指令剪刀石頭布現在只記錄零失誤的時間，\n所以已重設紀錄"
          }
        }
      }
    },
    "update_gift_message" : {
      "comment" : "Notice shown once after updating: the energy shown above is a present. Energy can be spent on stickers in the gacha and the sticker shop.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ist Energie als Geschenk!\nNutze sie beim Gacha oder in der Sticker-Ecke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here's some energy as a present!\nUse it in the Gacha or the Sticker Corner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Te regalamos energía!\nÚsala en el gacha o en el rincón de pegatinas."
          }
